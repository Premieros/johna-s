<Window x:Class="PremierPrintStation.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Premier Print Station" Height="760" Width="1180" MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft" Background="#F5F7FB">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="White" BorderBrush="#DDE3EC" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Premier Print Station" FontSize="24" FontWeight="Bold" Foreground="#152033"/>
          <TextBlock Text="محطة طباعة ويندوز — خدمة مستقلة + طابور محلي دائم" Foreground="#667085" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="StatusBadge" Background="#FEF3C7" CornerRadius="12" Padding="12,7" Margin="6,0">
            <TextBlock x:Name="StatusText" Text="غير متصل" Foreground="#92400E" FontWeight="Bold"/>
          </Border>
          <Button Content="تحديث" Padding="16,8" Margin="6,0" Click="Refresh_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Background="White" BorderBrush="#DDE3EC">
      <TabItem Header="لوحة المتابعة">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <UniformGrid Rows="1" Columns="4" Margin="0,0,0,14">
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16" Margin="5">
              <StackPanel><TextBlock Text="معلّق" Foreground="#64748B"/><TextBlock x:Name="PendingCount" Text="0" FontSize="30" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16" Margin="5">
              <StackPanel><TextBlock Text="يحتاج مراجعة" Foreground="#64748B"/><TextBlock x:Name="ReviewCount" Text="0" FontSize="30" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16" Margin="5">
              <StackPanel><TextBlock Text="آخر اتصال" Foreground="#64748B"/><TextBlock x:Name="LastHeartbeat" Text="—" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/></StackPanel>
            </Border>
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16" Margin="5">
              <StackPanel><TextBlock Text="الفرع" Foreground="#64748B"/><TextBlock x:Name="BranchSummary" Text="غير محدد" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/></StackPanel>
            </Border>
          </UniformGrid>
          <DataGrid Grid.Row="1" x:Name="JobsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
              <DataGridTextColumn Header="الوقت" Binding="{Binding CreatedAt}" Width="150"/>
              <DataGridTextColumn Header="النوع" Binding="{Binding Kind}" Width="90"/>
              <DataGridTextColumn Header="المحطة" Binding="{Binding StationCode}" Width="120"/>
              <DataGridTextColumn Header="الحالة" Binding="{Binding State}" Width="150"/>
              <DataGridTextColumn Header="المحاولات" Binding="{Binding Attempts}" Width="80"/>
              <DataGridTextColumn Header="آخر خطأ" Binding="{Binding LastError}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <TabItem Header="الطابور">
        <Grid Margin="16">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="إعادة محاولة المحدد" Padding="14,7" Margin="0,0,8,0" Click="RetrySelected_Click"/>
            <Button Content="طباعة Test" Padding="14,7" Click="TestPrint_Click"/>
          </StackPanel>
          <DataGrid Grid.Row="1" x:Name="QueueGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
              <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="220"/>
              <DataGridTextColumn Header="المحطة" Binding="{Binding StationCode}" Width="120"/>
              <DataGridTextColumn Header="الحالة" Binding="{Binding State}" Width="150"/>
              <DataGridTextColumn Header="آخر خطأ" Binding="{Binding LastError}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <TabItem Header="الإعدادات">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid Margin="18" MaxWidth="860">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <GroupBox Header="اتصال Supabase" Padding="14" Margin="0,0,0,14">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="Supabase URL" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="SupabaseUrlBox" Margin="6"/>
                <TextBlock Grid.Row="1" Text="Anon Key" VerticalAlignment="Center"/>
                <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="AnonKeyBox" Margin="6"/>
                <TextBlock Grid.Row="2" Text="Branch ID" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="BranchIdBox" Margin="6"/>
              </Grid>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="تسجيل الدخول للمحطة" Padding="14" Margin="0,0,0,14">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="Email" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="EmailBox" Margin="6"/>
                <TextBlock Grid.Row="1" Text="Password" VerticalAlignment="Center"/>
                <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="PasswordBox" Margin="6"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="6">
                  <Button Content="تسجيل الدخول وحفظ الجلسة" Padding="14,7" Click="SignIn_Click"/>
                  <TextBlock x:Name="AuthStatus" Margin="12,8,0,0" Foreground="#64748B"/>
                </StackPanel>
              </Grid>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="توجيه المحطات إلى الطابعات" Padding="14" Margin="0,0,0,14">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="kitchen" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="KitchenPrinterBox" Margin="6"/>
                <TextBlock Grid.Row="1" Text="bar" VerticalAlignment="Center"/><ComboBox Grid.Row="1" Grid.Column="1" x:Name="BarPrinterBox" Margin="6"/>
                <TextBlock Grid.Row="2" Text="cashier" VerticalAlignment="Center"/><ComboBox Grid.Row="2" Grid.Column="1" x:Name="CashierPrinterBox" Margin="6"/>
                <TextBlock Grid.Row="3" Text="receipt" VerticalAlignment="Center"/><ComboBox Grid.Row="3" Grid.Column="1" x:Name="ReceiptPrinterBox" Margin="6"/>
                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="6,10,6,0">
                  <TextBlock Text="محطات إضافية (سطر لكل محطة بالشكل station_code=Windows Printer Name)" Foreground="#64748B" Margin="0,0,0,5"/>
                  <TextBox x:Name="CustomMappingsBox" AcceptsReturn="True" MinHeight="90" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                </StackPanel>
              </Grid>
            </GroupBox>

            <StackPanel Grid.Row="3" Orientation="Horizontal">
              <Button Content="حفظ الإعدادات" Padding="16,8" Click="SaveSettings_Click"/>
              <Button Content="فتح مجلد البيانات" Padding="16,8" Margin="8,0,0,0" Click="OpenDataFolder_Click"/>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
